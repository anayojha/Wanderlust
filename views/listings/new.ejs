<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">
        <h3>Add New Listings</h3>
 
        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="listing[title]" placeholder="Enter your title" type="text" class="form-control" required> 
                <div class="valid-feedback"> Title is Good</div>
            </div>
            
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" required></textarea>      
                <div class="invalid-feedback"> Description is not good</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload Image</label>
                <input name="listing[image]" type="file" class="form-control" required>
                ]
            </div>
            
            <div class="row">

            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" placeholder="Enter your price" type="number" class="form-control" required>
                <div class="invalid-feedback">Price is not good</div>
            </div>
            
            <div class="mb-3 col-md-8">
                <label for="location" class="form-label">Location</label>
                <input name="listing[location]" placeholder="Enter your location" type="text" class="form-control" required>
                <div class="invalid-feedback"> Location is not good</div>
            </div>
            
            </div>

            <div class="mb-3">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" placeholder="Enter your country" type="text" class="form-control" required>
                <div class="invalid-feedback"> Country is not good</div>
            </div>
            <div class="mb-3">
    <label for="category" class="form-label">Category</label>

    <select
        class="form-select"
        id="category"
        name="listing[category]"
        required
    >
        <option value="">Select Category</option>
        <option value="Trending">Trending</option>
        <option value="Rooms">Rooms</option>
        <option value="Iconic Cities">Iconic Cities</option>
        <option value="Mountains">Mountains</option>
        <option value="Castles">Castles</option>
        <option value="Amazing Pools">Amazing Pools</option>
        <option value="Camping">Camping</option>
        <option value="Farms">Farms</option>
        <option value="Arctic">Arctic</option>
        <option value="Beach">Beach</option>
    </select>

    <div class="invalid-feedback">
        Please choose a category.
    </div>
</div>
            
            <button class="btn btn-dark add-btn">Add</button>
        </form>
        </div>
</div>
</body>
